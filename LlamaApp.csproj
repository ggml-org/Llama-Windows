<?xml version="1.0" encoding="UTF-8" ?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
        <OutputType>WinExe</OutputType>

        <!-- WinUI 3 -->
        <UseWinUI>true</UseWinUI>
        <EnableMsixTooling>true</EnableMsixTooling>
        <WindowsPackageType>MSIX</WindowsPackageType>

        <!-- Project Options -->
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>LlamaApp</RootNamespace>

        <!-- Exclude nested sub-project directories from the default item globs.
             They are compiled by their own .csproj files, not by this one. -->
        <DefaultItemExcludes>$(DefaultItemExcludes);LlamaApp.Common\**;LlamaApp.HuggingFace\**;LlamaApp.LlamaCpp\**;LlamaApp.LlamaCpp.Tests\**;LlamaApp.Catalog\**;LlamaApp.Tests\**</DefaultItemExcludes>

        <!-- App Options -->
        <UseRidGraph>true</UseRidGraph>
        <Platforms>x86;x64;ARM64</Platforms>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <!-- Embed the llama icon in the exe itself: the startup shortcut
             (StartupHelper) points its IconLocation at the exe, and Explorer
             falls back to it for unpackaged views of the binary. -->
        <ApplicationIcon>Assets\llama.ico</ApplicationIcon>
        <!-- Assembly/file version shown in the app footer (MainWindow reads
             AssemblyVersion). Keep in sync with Identity@Version in
             Package.appxmanifest — single-project MSIX takes the package
             version from the manifest, not from here. -->
        <Version>0.10.0.0</Version>
        <!-- Never emit a .msixbundle from the per-arch build. Shipping assets
             at several scales (Square44x44Logo.scale-*.png etc.) makes MakePri
             split resources into scale-* resource packages, and the default
             AppxBundle=Auto then packs main+resources as a .msixbundle in
             AppxPackageDir — the release workflow stages per-arch *.msix and
             would find nothing. A flat .msix carries all scales inline. -->
        <AppxBundle>Never</AppxBundle>
        <PublishProfile>win-$(Platform).pubxml</PublishProfile>
        <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')) >= 8">win-x86;win-x64;win-arm64</RuntimeIdentifiers>
        <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetFrameworkVersion('$(TargetFramework)')) &lt; 8">win10-x86;win10-x64;win10-arm64</RuntimeIdentifiers>

        <!-- WinUI 3 unpackaged apps must run with a concrete native platform so the
             apphost and native dependencies (WebView2 runtime, WinAppSDK projections)
             match an installed runtime. When a solution drives an "Any CPU" build
             (e.g. the .slnx), the SDK emits an ARM64 apphost on ARM64 Windows; an
             ARM64-native process cannot load the x64/ARM64EC WebView2 runtime that is
             installed there, so WebView2 initialization hangs forever and the page
             renders blank. Coerce Any CPU to x64: the x64 apphost runs natively on
             x64 Windows and via emulation on ARM64 Windows (matching the installed
             x64/ARM64EC WebView2 runtime), so WebView2 initializes correctly. -->
        <PlatformTarget Condition="'$(Platform)' == 'AnyCPU'">x64</PlatformTarget>
        <Authors>Hugging Face</Authors>
        <PackageProjectUrl>https://github.com/ggml-org/llama-windows</PackageProjectUrl>
        <Title>LlamaApp</Title>
        <RepositoryUrl>https://github.com/ggml-org/llama-windows</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <!-- All image assets — package logos at every scale (Start tile,
             taskbar, installer dialog, Add/Remove Programs, splash), the tray
             icon, and the per-row brand logos — ship as Content so the
             single-project MSIX packs them and they land next to the exe for
             AppContext.BaseDirectory lookups (see TrayIconManager). A glob, so
             a newly added asset can't be forgotten from the package. -->
        <Content Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="LlamaApp.slnx"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.*"/>
        <PackageReference Include="Microsoft.Web.WebView2" Version="1.*"/>
        <PackageReference Include="H.NotifyIcon" Version="2.*"/>
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.*"/>

        <Manifest Include="$(ApplicationManifest)"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The app consumes all three helper libraries. They are pure managed
             (net10.0) assemblies, so they build as Any CPU even when this WinUI
             app is built for a specific platform (x64/x86/ARM64). The solution
             files map them to Any CPU for platform-specific builds. -->
        <ProjectReference Include="LlamaApp.Common\LlamaApp.Common.csproj" />
        <ProjectReference Include="LlamaApp.HuggingFace\LlamaApp.HuggingFace.csproj" />
        <ProjectReference Include="LlamaApp.LlamaCpp\LlamaApp.LlamaCpp.csproj" />
    </ItemGroup>

    <!-- 
        Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
        Tools extension to be activated for this project even if the Windows App SDK Nuget
        package has not yet been restored.
    -->
    <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
        <ProjectCapability Include="Msix"/>
    </ItemGroup>
    <ItemGroup>
      <Folder Include="Assets\Logos\" />
    </ItemGroup>

    <!-- 
        Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution 
        Explorer "Package and Publish" context menu entry to be enabled for this project even if 
        the Windows App SDK Nuget package has not yet been restored.
    -->
    <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
        <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
    </PropertyGroup>
</Project>
