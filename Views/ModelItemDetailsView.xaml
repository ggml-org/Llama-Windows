<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="LlamaApp.Views.ModelItemDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LlamaApp.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        The model details panel, swapped into the same Fluent card that hosts
        the model list (MainWindow toggles visibility — no window, no frame
        navigation, so the tray flyout's compact chrome is preserved). All
        interaction state and every action lives in ModelItemDetailsViewModel;
        this file is presentation only, and the click handlers just forward
        to the ViewModel. Density matches the list: 12–13px text, 6–10px
        spacing, transparent-chrome buttons, 1px dividers.
    -->
    <!-- HorizontalScrollBarVisibility MUST be Disabled, not Hidden: Hidden
         still measures content with infinite width (the bar is merely not
         drawn), and wrapping content — the context ladder — bakes its row
         breaks from that infinite measure, then gets clipped at arrange. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled">
        <StackPanel Spacing="10">

            <!-- Back to the list. Chromeless; the glyph + dim label read as a
                 breadcrumb rather than a button. -->
            <Button x:Name="BackButton"
                    Click="Back_Click"
                    Padding="4,2"
                    MinWidth="0" MinHeight="0"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Back to the model list"
                    ToolTipService.ToolTip="Back to the model list">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;"
                              FontSize="11"
                              Opacity="0.6"
                              VerticalAlignment="Center" />
                    <TextBlock Text="Models"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Header: logo tile, name, "params · size · license" subtitle,
                 and the params/quant/vision chips. Everything binds straight
                 to the shared ModelItem — no copied state. -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="40" Height="40"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <Image Source="{x:Bind ViewModel.Model.Logo, Mode=OneWay}"
                           Stretch="Uniform"
                           Margin="5" />
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                    <!-- Name with the tags inline: the name column is capped so
                         a long name ellipsizes instead of pushing the chips
                         out of view. -->
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MaxWidth="215" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{x:Bind ViewModel.DisplayName}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   ToolTipService.ToolTip="{x:Bind ViewModel.Model.RowToolTip}" />
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="4"
                                    VerticalAlignment="Center">
                            <Border CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    Padding="4,0"
                                    Height="16"
                                    Visibility="{x:Bind ViewModel.HasParameterBadge, Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.ParameterBadge, Mode=OneWay}"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <Border CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    Padding="4,0"
                                    Height="16"
                                    Visibility="{x:Bind ViewModel.HasQuantizationBadge, Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.QuantizationBadge, Mode=OneWay}"
                                           FontSize="10"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <Border CornerRadius="{ThemeResource ControlCornerRadius}"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    Padding="4,0"
                                    Height="16"
                                    Visibility="{x:Bind ViewModel.Model.Vision, Mode=OneWay}"
                                    ToolTipService.ToolTip="Supports image input">
                                <FontIcon Glyph="&#xE890;"
                                          FontSize="11"
                                          Opacity="0.55"
                                          VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.HeaderSubtitle, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>

            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.AdvancedOptionsVisible, Mode=OneWay}">
            <!-- Context length · memory use. Data-driven: the options come
                 from the ViewModel, the memory math from the runtime layer.
                 On-disk models get the GGUF-derived ladder, later refined by
                 llama fit-params; downloadable rows with a catalog size get
                 the ladder grayed from the size against the memory budget.
                 Only this section shows progress while the details load;
                 the rest of the page renders immediately. -->
            <StackPanel Spacing="6"
                        Visibility="{x:Bind ViewModel.ContextSectionVisible, Mode=OneWay}">
                <Grid>
                    <StackPanel Orientation="Horizontal"
                                Spacing="4"
                                VerticalAlignment="Center">
                        <TextBlock Text="Context length · memory use"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <FontIcon Glyph="&#xE946;"
                                  FontSize="11"
                                  Opacity="0.5"
                                  VerticalAlignment="Center"
                                  ToolTipService.ToolTip="Approximate memory: model weights plus the KV cache at the saved K/V types. Reopen after changing K/V types." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal"
                                Spacing="6"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <local:ModelProgressRing Width="14" Height="14"
                                                 IsIndeterminate="True"
                                                 IsActive="{x:Bind ViewModel.IsLoadingDetails, Mode=OneWay}"
                                                 Visibility="{x:Bind ViewModel.IsLoadingDetails, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.EstimatedMemoryDisplay, Mode=OneWay}"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                           FontSize="12"
                           Foreground="#F85149"
                           TextWrapping="Wrap"
                           Visibility="{x:Bind ViewModel.HasError, Mode=OneWay}" />

                <!-- The context ladder: one row of compact label-only cells
                     (7 × 50 = 350 ≤ the 370 content width, scrollbar included).
                     The memory requirement moved to the hover tooltip — carried
                     on the wrapping Grid because a disabled button never shows
                     its own tooltip. Cells disable when the option exceeds the
                     model's max context or the machine's memory budget (free
                     VRAM + usable RAM, refined by llama fit-params for
                     on-disk models). The accent ring marks the selection. -->
                <ItemsControl ItemsSource="{x:Bind ViewModel.ContextLengths, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:ContextLengthOption">
                            <Grid Margin="0,0,4,0"
                                  ToolTipService.ToolTip="{x:Bind TooltipText}">
                                <Button Click="ContextOption_Click"
                                        Tag="{x:Bind}"
                                        IsEnabled="{x:Bind IsSelectable}"
                                        Width="46" Height="30"
                                        Padding="0"
                                        MinWidth="0" MinHeight="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        AutomationProperties.Name="{x:Bind Label}">
                                    <Grid CornerRadius="{ThemeResource ControlCornerRadius}"
                                          Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                        <TextBlock Text="{x:Bind Label}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Border CornerRadius="{ThemeResource ControlCornerRadius}"
                                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                                BorderThickness="1.5"
                                                Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                                    </Grid>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Expander Header="Inference settings for this model"
                      Visibility="{x:Bind ViewModel.ChatRowVisible, Mode=OneWay}">
                <StackPanel Spacing="8" Padding="0,8,0,4">
                    <TextBlock Text="The runtime backend stays server-wide. Other choices override server settings for the next load of this model. Zero inherits the server's batch setting."
                               FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                    <TextBlock x:Name="ModelCapabilityStatus" FontSize="11" Opacity="0.6"
                               TextWrapping="Wrap" />
                    <ComboBox x:Name="ModelGpuDeviceBox" Header="Compute device"
                              HorizontalAlignment="Stretch" />
                    <TextBlock x:Name="ModelGpuMemoryStatus" FontSize="11" Opacity="0.6"
                               TextWrapping="Wrap" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ModelGpuLayersBox" Grid.Column="0" Header="GPU layers"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Use server setting" Tag="" />
                            <ComboBoxItem Content="Automatic" Tag="auto" />
                            <ComboBoxItem Content="All" Tag="all" />
                            <ComboBoxItem Content="Custom" Tag="custom" />
                        </ComboBox>
                        <NumberBox x:Name="ModelGpuLayerCountBox" Grid.Column="1" Header="Custom layer count"
                                   Minimum="0" Maximum="1000" PlaceholderText="0–1000" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Batch size" FontSize="12" />
                            <NumberBox x:Name="ModelBatchSizeBox" Minimum="0" Maximum="8192"
                                       SmallChange="1" SpinButtonPlacementMode="Hidden" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="Microbatch size" FontSize="12" />
                            <NumberBox x:Name="ModelMicroBatchSizeBox" Minimum="0" Maximum="8192"
                                       SmallChange="1" SpinButtonPlacementMode="Hidden" />
                        </StackPanel>
                    </Grid>
                    <ComboBox x:Name="ModelFlashAttentionBox" Header="Flash Attention"
                              HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Use server setting" Tag="auto" />
                        <ComboBoxItem Content="On" Tag="on" />
                        <ComboBoxItem Content="Off" Tag="off" />
                    </ComboBox>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ModelCacheKBox" Grid.Column="0" Header="KV key type"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Use server setting" Tag="" />
                            <ComboBoxItem Content="f32" Tag="f32" />
                            <ComboBoxItem Content="f16" Tag="f16" />
                            <ComboBoxItem Content="bf16" Tag="bf16" />
                            <ComboBoxItem Content="q8_0" Tag="q8_0" />
                            <ComboBoxItem Content="q4_0" Tag="q4_0" />
                            <ComboBoxItem Content="q4_1" Tag="q4_1" />
                            <ComboBoxItem Content="iq4_nl" Tag="iq4_nl" />
                            <ComboBoxItem Content="q5_0" Tag="q5_0" />
                            <ComboBoxItem Content="q5_1" Tag="q5_1" />
                        </ComboBox>
                        <ComboBox x:Name="ModelCacheVBox" Grid.Column="1" Header="KV value type"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Use server setting" Tag="" />
                            <ComboBoxItem Content="f32" Tag="f32" />
                            <ComboBoxItem Content="f16" Tag="f16" />
                            <ComboBoxItem Content="bf16" Tag="bf16" />
                            <ComboBoxItem Content="q8_0" Tag="q8_0" />
                            <ComboBoxItem Content="q4_0" Tag="q4_0" />
                            <ComboBoxItem Content="q4_1" Tag="q4_1" />
                            <ComboBoxItem Content="iq4_nl" Tag="iq4_nl" />
                            <ComboBoxItem Content="q5_0" Tag="q5_0" />
                            <ComboBoxItem Content="q5_1" Tag="q5_1" />
                        </ComboBox>
                    </Grid>
                    <Expander Header="Threads, slots, and generation">
                        <StackPanel Spacing="6" Padding="0,8,0,4">
                            <NumberBox x:Name="ModelThreadsBox" Header="Generation threads (0 = inherit)"
                                       Minimum="0" Maximum="1024" />
                            <NumberBox x:Name="ModelThreadsBatchBox" Header="Prompt threads (0 = inherit)"
                                       Minimum="0" Maximum="1024" />
                            <NumberBox x:Name="ModelParallelBox" Header="Parallel slots (0 = inherit)"
                                       Minimum="0" Maximum="256" />
                            <TextBlock Text="Generation defaults can be overridden by the chat UI or an API request."
                                       FontSize="11" Opacity="0.6" TextWrapping="Wrap" />
                            <NumberBox x:Name="ModelTemperatureBox" Header="Temperature"
                                       Minimum="0" Maximum="5" PlaceholderText="Inherit" />
                            <NumberBox x:Name="ModelTopKBox" Header="Top K"
                                       Minimum="0" Maximum="10000" PlaceholderText="Inherit" />
                            <NumberBox x:Name="ModelTopPBox" Header="Top P"
                                       Minimum="0" Maximum="1" PlaceholderText="Inherit" />
                            <NumberBox x:Name="ModelRepeatPenaltyBox" Header="Repeat penalty"
                                       Minimum="0" Maximum="5" PlaceholderText="Inherit" />
                        </StackPanel>
                    </Expander>
                    <Expander Header="Multiple GPUs" Visibility="{x:Bind ViewModel.ExpertOptionsVisible, Mode=OneWay}">
                        <StackPanel Spacing="6" Padding="0,8,0,4">
                            <ComboBox x:Name="ModelSplitModeBox" Header="Split mode" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Use server setting" Tag="" />
                                <ComboBoxItem Content="None" Tag="none" />
                                <ComboBoxItem Content="Layer" Tag="layer" />
                                <ComboBoxItem Content="Row" Tag="row" />
                                <ComboBoxItem Content="Tensor" Tag="tensor" />
                            </ComboBox>
                            <TextBox x:Name="ModelTensorSplitBox" Header="Tensor split weights"
                                     PlaceholderText="Inherit, or e.g. 3,1" />
                        </StackPanel>
                    </Expander>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save for this model" Click="SavePromptProfile_Click" />
                        <Button Content="Reset" Click="ResetPromptProfile_Click" />
                    </StackPanel>
                    <TextBlock x:Name="PromptProfileStatus" FontSize="11"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Expander>
            </StackPanel>

            <Rectangle Height="1"
                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- Actions. Every row is a full-width transparent button; the
                 ViewModel owns availability (IsEnabled/Visibility bindings).
                 All glyphs exist in both Segoe Fluent Icons and Segoe MDL2
                 Assets (FontIcon falls back to MDL2). -->
            <StackPanel Spacing="2">

                <!-- Chat with model (installed only): loads first when needed. -->
                <Button Click="Chat_Click"
                        Visibility="{x:Bind ViewModel.ChatRowVisible, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.ChatActionEnabled, Mode=OneWay}"
                        Padding="8,6"
                        MinWidth="0" MinHeight="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="Chat with model">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8BD;" FontSize="16" Opacity="0.7" />
                        <TextBlock Text="{x:Bind ViewModel.ChatActionText, Mode=OneWay}"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Download (Hub models only), with the size on the right so a
                     one-tap download never hides its cost. -->
                <Button Click="Download_Click"
                        Visibility="{x:Bind ViewModel.CanDownload, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanDownload, Mode=OneWay}"
                        Padding="8,6"
                        MinWidth="0" MinHeight="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="Download this model">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE896;" FontSize="16" Opacity="0.7" />
                            <TextBlock Text="Download"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.SizeDisplay, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <!-- Copy model ID, with a transient check-mark feedback. -->
                <Button Click="CopyModelId_Click"
                        Padding="8,6"
                        MinWidth="0" MinHeight="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="Copy model ID"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ServerModelId, Mode=OneWay}">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE8C8;" FontSize="16" Opacity="0.7" />
                            <TextBlock Text="Copy model ID"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <FontIcon Glyph="&#xE8FB;"
                                  FontSize="12"
                                  Foreground="#3FB950"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Visibility="{x:Bind ViewModel.ModelIdCopied, Mode=OneWay}" />
                    </Grid>
                </Button>

                <!-- Build an API request: copies a ready-to-run curl command. -->
                <Button Click="BuildApiRequest_Click"
                        Padding="8,6"
                        MinWidth="0" MinHeight="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="Build an API request"
                        ToolTipService.ToolTip="Copy a curl command for this model's chat endpoint">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE943;" FontSize="16" Opacity="0.7" />
                            <TextBlock Text="Build an API request"
                                       FontSize="13"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <FontIcon Glyph="&#xE8FB;"
                                  FontSize="12"
                                  Foreground="#3FB950"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Visibility="{x:Bind ViewModel.ApiRequestCopied, Mode=OneWay}" />
                    </Grid>
                </Button>

                <!-- View on Hugging Face (disabled when the repo id is unknown). -->
                <Button Click="OpenRepository_Click"
                        IsEnabled="{x:Bind ViewModel.CanOpenRepository, Mode=OneWay}"
                        Padding="8,6"
                        MinWidth="0" MinHeight="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.Name="View on Hugging Face">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8A7;" FontSize="16" Opacity="0.7" />
                        <TextBlock Text="View on Hugging Face"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Rectangle Height="1"
                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                       Visibility="{x:Bind ViewModel.CanDelete, Mode=OneWay}" />

            <!-- Delete (installed, unloaded models only), size on the right —
                 same red as the row's confirmation flyout. -->
            <Button Click="Delete_Click"
                    Visibility="{x:Bind ViewModel.CanDelete, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanDelete, Mode=OneWay}"
                    Padding="8,6"
                    MinWidth="0" MinHeight="0"
                    Background="Transparent"
                    BorderThickness="0"
                    CornerRadius="{ThemeResource ControlCornerRadius}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="Delete model">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="#F85149" />
                        <TextBlock Text="Delete"
                                   FontSize="13"
                                   Foreground="#F85149"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.SizeDisplay, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center" />
                </Grid>
            </Button>

        </StackPanel>
    </ScrollViewer>
</UserControl>
