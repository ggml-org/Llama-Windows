<?xml version="1.0" encoding="UTF-8" ?>
<UserControl
    x:Class="LlamaApp.Views.ModelFamilyDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LlamaApp.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        The model FAMILY details panel, swapped into the same Fluent card
        that hosts the model list (MainWindow toggles visibility — no window,
        no frame navigation). Hierarchy: family header → parameter size
        cells → variant rows (whole row downloads) → technical details.
        Presentation only; ModelFamilyDetailsViewModel owns the state.
        Density matches the list: 12–13px text, 6–10px spacing,
        transparent-chrome buttons, 1px dividers.
    -->
    <!-- HorizontalScrollBarVisibility MUST be Disabled, not Hidden (see the
         same comment in ModelItemDetailsView). -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalScrollMode="Disabled">
        <StackPanel Spacing="10">

            <!-- Back to the list. Chromeless breadcrumb, same as the model
                 details view. -->
            <Button x:Name="BackButton"
                    Click="Back_Click"
                    Padding="4,2"
                    MinWidth="0" MinHeight="0"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="Back to the model list"
                    ToolTipService.ToolTip="Back to the model list">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72B;"
                              FontSize="11"
                              Opacity="0.6"
                              VerticalAlignment="Center" />
                    <TextBlock Text="Models"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <!-- Header: logo tile + family name + one-paragraph description. -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="40" Height="40"
                        CornerRadius="{ThemeResource ControlCornerRadius}"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <Image Source="{x:Bind ViewModel.Logo, Mode=OneWay}"
                           Stretch="Uniform"
                           Margin="5" />
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                    <TextBlock Text="{x:Bind ViewModel.Name}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{x:Bind ViewModel.Description}"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"
                               MaxLines="2"
                               TextTrimming="CharacterEllipsis"
                               Visibility="{x:Bind ViewModel.HasDescription, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <!-- Choose a model size: one row of compact cells (the same
                 pattern as the details view's context ladder). The accent
                 ring marks the selection. -->
            <StackPanel Spacing="6">
                <TextBlock Text="Choose a model size"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Sizes, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:ModelFamilySizeOption">
                            <!-- The button IS the tile (no chromeless padding
                                 around a smaller inner tile — the button's
                                 hover fill would paint the padding zone too
                                 and make the cell look like it grows on
                                 hover). The selection ring is a hit-test-
                                 transparent overlay sibling. -->
                            <Grid Margin="0,0,4,0"
                                  ToolTipService.ToolTip="{x:Bind FullName}">
                                <Button Click="SizeOption_Click"
                                        Tag="{x:Bind}"
                                        MinWidth="46" Height="30"
                                        Padding="8,0"
                                        MinHeight="0"
                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                        BorderThickness="0"
                                        CornerRadius="{ThemeResource ControlCornerRadius}"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        AutomationProperties.Name="{x:Bind FullName}">
                                    <TextBlock Text="{x:Bind Label}"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                </Button>
                                <Border CornerRadius="{ThemeResource ControlCornerRadius}"
                                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                        BorderThickness="1.5"
                                        IsHitTestVisible="False"
                                        Visibility="{x:Bind IsSelected, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Choose a version: one row per quant of the selected size.
                 The whole row is the download button — friendly quality name
                 first, the raw quant + download size as secondary text, so a
                 one-tap download never hides its cost. Installed variants
                 read as such and are disabled. -->
            <StackPanel Spacing="2"
                        Visibility="{x:Bind ViewModel.HasVariants, Mode=OneWay}">
                <TextBlock Text="Choose a version"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Variants, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:ModelFamilyVariantOption">
                            <Button Click="Variant_Click"
                                    Tag="{x:Bind}"
                                    IsEnabled="{x:Bind IsSelectable}"
                                    Padding="8,6"
                                    MinWidth="0" MinHeight="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="{ThemeResource ControlCornerRadius}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    AutomationProperties.Name="{x:Bind AccessibleName}">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0"
                                              Glyph="&#xE896;"
                                              FontSize="16"
                                              Opacity="0.7"
                                              VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{x:Bind FriendlyName}"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2"
                                               Text="{x:Bind DetailText}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3"
                                               Text="{x:Bind StateCaption}"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Rectangle Height="1"
                       Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

            <!-- Technical details: secondary metadata, provider-neutral, no
                 ranking or recommendation. -->
            <StackPanel Spacing="4">
                <TextBlock Text="Technical details"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="Provider"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Grid.Row="0" Grid.Column="1"
                               Text="{x:Bind ViewModel.Provider}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="License"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Grid.Row="1" Grid.Column="1"
                               Text="{x:Bind ViewModel.License}"
                               FontSize="12"
                               TextTrimming="CharacterEllipsis" />

                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="Format"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    <TextBlock Grid.Row="2" Grid.Column="1"
                               Text="{x:Bind ViewModel.Format}"
                               FontSize="12" />
                </Grid>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
