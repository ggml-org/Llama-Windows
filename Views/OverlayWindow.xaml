<?xml version="1.0" encoding="UTF-8" ?>
<Window
    x:Class="LlamaApp.Views.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Spotlight-style prompt overlay. Borderless, Mica backdrop, centered on
        the active monitor. A single text input + a streaming response area.
        Esc (or losing focus) dismisses it. Only useful while the app is running
        and a model is loaded — otherwise the input is disabled with a hint.
    -->
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid Padding="14" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- model badge -->
            <RowDefinition Height="Auto" /> <!-- input -->
            <RowDefinition Height="*" />    <!-- response (scrolls) -->
        </Grid.RowDefinitions>

        <!-- Loaded-model badge: dim caption above the input. -->
        <TextBlock x:Name="ModelBadge"
                   Grid.Row="0"
                   FontSize="11"
                   Opacity="0.6"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis" />

        <!-- The input field. Enter sends; Esc closes. -->
        <TextBox x:Name="InputBox"
                 Grid.Row="1"
                 PlaceholderText="Ask the loaded model…"
                 AcceptsReturn="False"
                 TextWrapping="Wrap"
                 MaxHeight="80"
                 KeyDown="InputBox_KeyDown" />

        <!-- Streaming response. -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Hidden"
                      HorizontalScrollMode="Disabled">
            <TextBlock x:Name="ResponseText"
                       FontSize="13"
                       TextWrapping="WrapWholeWords"
                       IsTextSelectionEnabled="True" />
        </ScrollViewer>
    </Grid>
</Window>
