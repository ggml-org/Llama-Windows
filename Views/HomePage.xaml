<Page
    x:Class="LlamaApp.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LlamaApp.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Container for GridView cards: stretch to fill the adaptive slot. -->
        <Style x:Key="FixedCardContainer" TargetType="GridViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>

        <!-- Shared card template used by both model grids.
             Shows a transparent overlay with a Play icon (available models)
             or a Download icon (Hub models) on hover. -->
        <DataTemplate x:Key="ModelCardTemplate" x:DataType="local:ModelItem">
            <Grid Background="{ThemeResource ControlFillColorDefaultBrush}"
                  CornerRadius="8"
                  Padding="4"
                  Margin="4"
                  RowSpacing="4"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  PointerEntered="Card_PointerEntered"
                  PointerExited="Card_PointerExited">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo (centered horizontally in the card) -->
                <Border Grid.Row="0"
                        Width="56" Height="56"
                        CornerRadius="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}">
                    <Image Source="{x:Bind Logo}"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
                </Border>

                <!-- Name (short form: last path segment after '/'), under the image -->
                <TextBlock Grid.Row="1"
                           Text="{x:Bind DisplayName}"
                           FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <!-- Params / Size / License -->
                <StackPanel Grid.Row="2" VerticalAlignment="Bottom" Spacing="2" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Params:" FontSize="11" Opacity="0.6" />
                        <TextBlock Text="{x:Bind Parameters}" FontSize="11" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="Size:" FontSize="11" Opacity="0.6" />
                        <TextBlock Text="{x:Bind Size}" FontSize="11" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="License:" FontSize="11" Opacity="0.6" />
                        <TextBlock Text="{x:Bind License}" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <!-- Hover overlay: transparent scrim + centered icon -->
                <Border x:Name="HoverOverlay"
                        Grid.Row="0" Grid.RowSpan="3"
                        Background="#80000000"
                        CornerRadius="8"
                        Opacity="0"
                        IsHitTestVisible="False">
                    <Grid>
                        <!-- Play icon (available / downloaded models) -->
                        <FontIcon Glyph="&#xE768;"
                                  FontSize="34"
                                  Foreground="White"
                                  Visibility="{x:Bind Downloadable, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}" />
                        <!-- Download icon (Hub models) -->
                        <FontIcon Glyph="&#xE896;"
                                  FontSize="34"
                                  Foreground="White"
                                  Visibility="{x:Bind Downloadable, Converter={StaticResource BoolToVisibility}, Mode=OneWay}" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="8*" />
        </Grid.RowDefinitions>

        <!-- ============ Section 1: Brand Header (30%, full width, centered) ============ -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal" Spacing="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="20,20,20,6">
            <Image Source="ms-appx:///Assets/llama-white.svg"
                   Width="50" Height="50"
                   Stretch="Uniform" />
            <TextBlock Text="llama"
                       FontSize="32" FontWeight="SemiBold"
                       Foreground="White"
                       VerticalAlignment="Center" />
            <TextBlock Text=".app"
                       FontSize="32" FontWeight="SemiBold"
                       Foreground="#FF8A3D"
                       Margin="-15,0,0,0"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- ============ Section 2: Models (70%, split into two equal halves) ============ -->
        <Grid Grid.Row="1" Margin="20,6,20,20" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Available Models -->
            <Border Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Available models header + divider -->
                    <StackPanel Grid.Row="0" Spacing="8">
                        <TextBlock Text="Available Models"
                                   FontSize="16" FontWeight="SemiBold" />
                        <Rectangle Height="1" HorizontalAlignment="Stretch"
                                   Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    </StackPanel>
                    
                    <!-- Available models grid (run/play on hover) -->
                    <GridView Grid.Row="1"
                              x:Name="AvailableGrid"
                              ItemsSource="{x:Bind DownloadedModels}"
                              ItemTemplate="{StaticResource ModelCardTemplate}"
                              ItemContainerStyle="{StaticResource FixedCardContainer}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              SizeChanged="ModelGrid_SizeChanged">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                    </GridView>
                </Grid>
            </Border>

            <!-- Downloadable Models -->
            <Border Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Downloadable models header + divider -->
                    <StackPanel Grid.Row="0" Spacing="8">
                        <TextBlock Text="Trending Models"
                                   FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <Rectangle Height="1" HorizontalAlignment="Stretch"
                                   Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                    </StackPanel>

                    <!-- Downloadable models grid (download on hover) -->
                    <GridView Grid.Row="1"
                              x:Name="HubGrid"
                              ItemsSource="{x:Bind HubModels}"
                              ItemTemplate="{StaticResource ModelCardTemplate}"
                              ItemContainerStyle="{StaticResource FixedCardContainer}"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              SizeChanged="ModelGrid_SizeChanged">
                        <GridView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <ItemsWrapGrid Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </GridView.ItemsPanel>
                    </GridView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
