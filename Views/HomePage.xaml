<Page
    x:Class="LlamaApp.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LlamaApp.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Margin="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Section 1: System Usage (CPU / Memory / GPU) ============ -->
        <Border Grid.Row="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            
            <Grid ColumnSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- CPU -->
                <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="CPU" FontSize="12" Opacity="0.7" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" Value="34" Maximum="100" />
                        <TextBlock Grid.Column="1" Text="34%" FontSize="13" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>

                <!-- Memory -->
                <StackPanel Grid.Column="1" Spacing="6">
                    <TextBlock Text="Memory" FontSize="12" Opacity="0.7" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" Value="58" Maximum="100" />
                        <TextBlock Grid.Column="1" Text="9.3 / 16 GB" FontSize="13" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>

                <!-- GPU -->
                <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock Text="GPU" FontSize="12" Opacity="0.7" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0" Value="12" Maximum="100" />
                        <TextBlock Grid.Column="1" Text="12%" FontSize="13" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Section 2: Downloaded Models Carousel ============ -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <StackPanel Spacing="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Available Models"
                               FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" x:Name="DownloadedCount"
                               Text="0 models" FontSize="12" Opacity="0.6"
                               VerticalAlignment="Center" />
                </Grid>

                <FlipView x:Name="DownloadedCarousel"
                          Height="120"
                          Background="Transparent"
                          BorderThickness="0"
                          ItemsSource="{x:Bind DownloadedModels}">
                    <FlipView.ItemTemplate>
                        <DataTemplate x:DataType="local:ModelItem">
                            <Grid Padding="8" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="80" Height="80"
                                        CornerRadius="8"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}">
                                    <Image Source="{x:Bind Logo}"
                                           Stretch="UniformToFill"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Name}"
                                               FontSize="16" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Description}"
                                               FontSize="12" Opacity="0.7"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="Params:" FontSize="12" Opacity="0.6" />
                                            <TextBlock Text="{x:Bind Parameters}" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="Size:" FontSize="12" Opacity="0.6" />
                                            <TextBlock Text="{x:Bind Size}" FontSize="12" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="License:" FontSize="12" Opacity="0.6" />
                                            <TextBlock Text="{x:Bind License}" FontSize="12" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </FlipView.ItemTemplate>
                </FlipView>
            </StackPanel>
        </Border>

        <!-- ============ Section 3: Hugging Face Hub - Available Models ============ -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <Grid RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Hugging Face Hub"
                               FontSize="16" FontWeight="SemiBold" />
                    <TextBox Grid.Column="1"
                             x:Name="HubSearchBox"
                             PlaceholderText="Search models..."
                             Width="240" />
                </Grid>

                <ListView Grid.Row="1"
                          x:Name="HubList"
                          ItemsSource="{x:Bind HubModels}"
                          SelectionMode="None"
                          IsItemClickEnabled="True">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:ModelItem">
                            <Grid Padding="4,8" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Description}"
                                               FontSize="12" Opacity="0.7"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind Parameters}"
                                           VerticalAlignment="Center"
                                           FontSize="12" Opacity="0.8" />
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind License}"
                                           VerticalAlignment="Center"
                                           FontSize="12" Opacity="0.8" />
                                <TextBlock Grid.Column="3"
                                           Text="{x:Bind Size}"
                                           VerticalAlignment="Center"
                                           FontSize="12" Opacity="0.8" />
                                <Button Grid.Column="4"
                                        Style="{StaticResource Action}"
                                        Content="Download" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
