<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="LlamaApp.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LlamaApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Page.Content>
        <NavigationView
            PaneDisplayMode="LeftCompact"
            IsPaneToggleButtonVisible="False"
            IsPaneOpen="False">
            <NavigationView.MenuItems>
                <NavigationViewItem Icon="Home" Content="Home" Tag="SamplePage1" />
                <NavigationViewItem Icon="Find" Content="Search Model" Tag="SamplePage2" />
                <NavigationViewItem Icon="SaveLocal" Content="Manage Models" Tag="SamplePage2" />
            </NavigationView.MenuItems>

            <StackPanel HorizontalAlignment="Center"
                Spacing="25" Margin="25">

                <TextBlock x:Name="UserText" FontSize="32"></TextBlock>
            </StackPanel>
        </NavigationView>
    </Page.Content>
</Page>
