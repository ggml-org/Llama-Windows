<?xml version="1.0" encoding="UTF-8" ?>
<Window
    x:Class="LlamaApp.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LlamaApp"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>
    
    <NavigationView
        x:Name="MenuControl"
        PaneDisplayMode="LeftCompact"
        IsBackEnabled="False"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="False"
        IsPaneOpen="False">
        <NavigationView.MenuItems>
            <NavigationViewItem Icon="Home" Content="Home" Tag="HomePage" />
            <NavigationViewItem Icon="Find" Content="Search Model" Tag="SearchModelsPage" />
            <NavigationViewItem Icon="SaveLocal" Content="Manage Models" Tag="LocalModelsPage" />
        </NavigationView.MenuItems>
        <NavigationView.FooterMenuItems>
            <NavigationViewItem Content="Account" Tag="HuggingFaceAccountPage" Icon="Contact" />
        </NavigationView.FooterMenuItems>
        <Frame x:Name="ContentFrame" Navigated="ContentFrame_OnNavigated"/>
    </NavigationView>
</Window>