<?xml version="1.0" encoding="UTF-8" ?>
<Window
    x:Class="LlamaApp.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:LlamaApp.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        This window is never shown as a normal top-level window. It is styled
        as a Windows 11 flyout (borderless, Mica backdrop, rounded corners) and
        only ever appears anchored to the system-tray icon, dismissing itself
        when it loses focus — mirroring the macOS menu-bar app on Windows.

        The content is a vertical Grid with four sections separated by divider
        lines. Sections 1, 2, 4 take their natural height; section 3 stretches
        to fill the remaining space (Row *):
          1. Brand header (logo + llama.app)          — Auto, compact
          2. Available (local models, or "No model yet") — Auto
          3. Recommended Models                        — * (stretches)
          4. Footer (app version, llama.cpp version, Settings, Quit) — Auto, compact
    -->
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <!-- Local model row: icon + name/params·size + play glyph. -->
            <DataTemplate x:Key="LocalModelRowTemplate"
                          x:DataType="local:ModelItem">
                <Grid Padding="8,6"
                      ColumnSpacing="10"
                      CornerRadius="6"
                      Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="32" Height="32"
                            CornerRadius="6"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}">
                        <Image Source="{x:Bind Logo}"
                               Stretch="Uniform"
                               Margin="4" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="1">
                        <TextBlock Text="{x:Bind DisplayName}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="11"
                                   Opacity="0.6"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="{x:Bind Parameters}" />
                            <Run Text=" · " />
                            <Run Text="{x:Bind Size}" />
                        </TextBlock>
                    </StackPanel>

                    <FontIcon Grid.Column="2"
                              Glyph="&#xE768;"
                              FontSize="16"
                              Opacity="0.5"
                              VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>

            <!-- Recommended model row: icon + name/params·license + download glyph. -->
            <DataTemplate x:Key="RecommendedModelRowTemplate"
                          x:DataType="local:ModelItem">
                <Grid Padding="8,6"
                      ColumnSpacing="10"
                      CornerRadius="6"
                      Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="32" Height="32"
                            CornerRadius="6"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}">
                        <Image Source="{x:Bind Logo}"
                               Stretch="Uniform"
                               Margin="4" />
                    </Border>

                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="1">
                        <TextBlock Text="{x:Bind DisplayName}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock FontSize="11"
                                   Opacity="0.6"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="{x:Bind Parameters}" />
                            <Run Text=" · " />
                            <Run Text="{x:Bind License}" />
                        </TextBlock>
                    </StackPanel>

                    <FontIcon Grid.Column="2"
                              Glyph="&#xE896;"
                              FontSize="16"
                              Opacity="0.5"
                              VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Section 1: brand header -->
            <RowDefinition Height="Auto" /> <!-- Divider -->
            <RowDefinition Height="Auto" /> <!-- Section 2: Available -->
            <RowDefinition Height="Auto" /> <!-- Divider -->
            <RowDefinition Height="*" />    <!-- Section 3: Recommended (stretches) -->
            <RowDefinition Height="Auto" /> <!-- Divider -->
            <RowDefinition Height="Auto" /> <!-- Section 4: footer -->
        </Grid.RowDefinitions>

        <!-- ============ Section 1: Brand header (compact) ============ -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="0,10,0,8">
            <Image Source="ms-appx:///Assets/llama-white.svg"
                   Width="20" Height="20"
                   Stretch="Uniform" />
            <StackPanel Orientation="Horizontal"
                        Spacing="1"
                        VerticalAlignment="Center">
                <TextBlock Text="llama"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="White"
                           VerticalAlignment="Center" />
                <TextBlock Text=".app"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#FF8A3D"
                           VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <Rectangle Grid.Row="1"
                   Height="1"
                   Margin="16,0"
                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- ============ Section 2: Available (local models) ============ -->
        <StackPanel Grid.Row="2"
                    Margin="16,12,16,12" Spacing="8">
            <TextBlock Text="Available"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Opacity="0.7" />

            <!-- Empty state — shown when there are no local models. -->
            <TextBlock x:Name="NoLocalModelsText"
                       Text="No model yet"
                       FontSize="13"
                       Opacity="0.45"
                       HorizontalAlignment="Center"
                       Margin="0,8,0,8" />

            <!-- Local model rows (run on click). -->
            <ItemsRepeater x:Name="LocalModelsList"
                           ItemsSource="{x:Bind LocalModels}"
                           ItemTemplate="{StaticResource LocalModelRowTemplate}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="2" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </StackPanel>

        <Rectangle Grid.Row="3"
                   Height="1"
                   Margin="16,0"
                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- ============ Section 3: Recommended Models (stretches) ============ -->
        <StackPanel Grid.Row="4"
                    Margin="16,12,16,12" Spacing="8">
            <TextBlock Text="Recommended Models"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Opacity="0.7" />

            <!-- Scrolls internally if the list outgrows the stretched row. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Hidden"
                          HorizontalScrollMode="Disabled">
                <ItemsRepeater x:Name="RecommendedModelsList"
                               ItemsSource="{x:Bind RecommendedModels}"
                               ItemTemplate="{StaticResource RecommendedModelRowTemplate}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="2" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>
        </StackPanel>

        <Rectangle Grid.Row="5"
                   Height="1"
                   Margin="16,0"
                   Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <!-- ============ Section 4: Footer (compact) ============ -->
        <Grid Grid.Row="6"
              Margin="16,8,16,8"
              ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Version lines (single line each, small) -->
            <StackPanel Grid.Column="0"
                        Spacing="0"
                        VerticalAlignment="Center">
                <TextBlock x:Name="AppVersionText"
                           FontSize="11"
                           Opacity="0.5" />
                <TextBlock x:Name="LlamaVersionText"
                           FontSize="11"
                           Opacity="0.5" />
            </StackPanel>

            <!-- Settings + Quit -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center">
                <Button Content="Settings"
                        Padding="10,3"
                        MinWidth="0"
                        FontSize="12"
                        Click="Settings_Click" />
                <Button Content="Quit"
                        Padding="10,3"
                        MinWidth="0"
                        FontSize="12"
                        Click="Quit_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
